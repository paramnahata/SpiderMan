// scores/{Firebase Auth UID}: public alias (15 chars), bestScore (integer 1..1000000),
// updatedAt (server timestamp). No email or private profile fields are permitted.
// Public reads are intentional for the user-requested leaderboard. Writes belong
// to the UID in the document path. All other collections retain default deny.
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() { return request.auth != null; }
    function isOwner(uid) { return isAuthenticated() && request.auth.uid == uid; }
    match /scores/{uid} {
      function validScore() {
        let data = request.resource.data;
        return data.keys().hasAll(['bestScore', 'alias', 'updatedAt'])
          && data.keys().hasOnly(['bestScore', 'alias', 'updatedAt'])
          && data.bestScore is int && data.bestScore >= 1 && data.bestScore <= 1000000
          && data.alias is string && data.alias.size() == 15
          && data.alias == 'Spider-' + uid[0:8]
          && data.updatedAt is timestamp && data.updatedAt == request.time;
      }
      allow get: if true;
      allow list: if request.query.limit != null && request.query.limit <= 20;
      allow create: if isOwner(uid) && validScore();
      allow update: if isOwner(uid) && validScore()
        && request.resource.data.alias == resource.data.alias
        && request.resource.data.bestScore > resource.data.bestScore;
      allow delete: if false;
    }
  }
}
